# ==============================================================================
# AI VERIFY — Intelligent Application & Compliance Platform
# Environment Configuration
# ==============================================================================

PROJECT_NAME="AI Verify — Intelligent Application & Compliance Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./ai_verify.db"
# Production PostgreSQL (Supabase / Managed PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_verify"

# Document Storage Directory
STORAGE_DIR="./storage_data"
MAX_FILE_SIZE_MB=15

# AI Provider Configuration (Google Gemini API)
# Leave empty for offline local deterministic demonstration mode:
DEMO_MODE=true
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
